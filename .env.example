# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bd_voter_auth

# Long random string used to sign session tokens
JWT_SECRET=change-me

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public URL of the site, used in candidate account emails
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Percentage of voter support needed before a petition can remove a candidate
PETITION_REMOVE_THRESHOLD_PERCENT=30
